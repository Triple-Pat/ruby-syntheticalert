extends: default

rules:
  line-length:
    max: 200
  truthy:
    check-keys: false
  comments:
    min-spaces-from-content: 1
  document-start: disable
  indentation:
    spaces: 2
    indent-sequences: consistent

# ruby/setup-ruby's bundler-cache installs gems into vendor/bundle inside the
# checkout, and third-party gems ship YAML we do not own.
ignore:
  - vendor/
